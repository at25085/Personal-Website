---
const { title, description, tags = [], projectUrl = "#" } = Astro.props;
---

<div class="col-12 col-md-6 hidden-slide">
  <div class="skillset p-3 h-100">
    <div class="ps-2 pe-1 py-3">
      <h2 class="exphead mb-3 fs-4">{title}</h2>
      <p class="posdesc text-break">{description}</p>
      <div class="d-flex flex-wrap gap-2 mb-3">
        {tags.map((tag) => (
          <div class="posskill d-inline-flex justify-content-center align-items-center px-3 py-1">
            <p class="mb-0">{tag}</p>
          </div>
        ))}
      </div>
      <a href={projectUrl}>
        <p class="viewproject pt-3 mb-0">View Project →</p>
      </a>
    </div>
  </div>
</div>