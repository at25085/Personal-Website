---
const { company, dateRange, role, description, skills = [] } = Astro.props;
---

<div class="row gy-4 gx-0 pb-4 justify-content-center hidden-slide"> 
  <div class="col-12 skillset p-3 h-100">
    <div class="row align-items-baseline">
      
      <div class="col-12 col-sm-3 ps-4 pt-3">
        <h3 class="exphead pb-1">{company}</h3>
        <p class="expyr">{dateRange}</p>
      </div>
      
      <div class="col-12 col-sm-9 ps-5 pe-4 pb-3">
        <h4 class="poshead">{role}</h4>
        <ul class="posdesc text-break ps-3 mb-4">
          {description.map((bullet) => (
            <li class="mb-2">{bullet}</li>
          ))}
        </ul>
        <div class="d-flex flex-wrap gap-2">
          {skills.map((skill) => (
            <div class="posskill d-inline-flex justify-content-center align-items-center px-3 py-1">
              <p class="mb-0">{skill}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</div>
